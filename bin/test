#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

ruby -Itest test/template_test.rb

if [[ "${INTEGRATION:-0}" == "1" ]]; then
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT

  mise exec ruby@4.0.5 -- rails new "$tmpdir/generated_app" \
    --database=postgresql \
    --css=tailwind \
    --skip-git \
    --template="$(pwd)/template.rb"

  cd "$tmpdir/generated_app"
  for skill in conventional-comments conventional-commits tdd-workflow team-code-review; do
    test -L ".claude/skills/$skill"
    test "$(readlink ".claude/skills/$skill")" = "../../.agents/skills/$skill"
    test -f ".claude/skills/$skill/SKILL.md"
  done

  test ! -e db/queue_schema.rb && test ! -e db/cache_schema.rb && test ! -e db/cable_schema.rb
  for table in solid_queue_jobs solid_cache_entries solid_cable_messages; do
    grep -q "create_table \"$table\"" db/schema.rb
  done
  if grep -Eq "^  (primary|queue|cache|cable):" config/database.yml ||
    grep -q "connects_to" config/cable.yml config/environments/production.rb ||
    grep -q "database: cache" config/cache.yml; then
    echo "Solid Queue, Cache, or Cable still points at a separate database" >&2
    exit 1
  fi

  git init --quiet
  empty_tree="$(git hash-object -t tree /dev/null)"
  mise exec ruby@4.0.5 -- bin/dependency-policy
  mise exec ruby@4.0.5 -- bundle exec rspec
  mise exec ruby@4.0.5 -- bundle exec srb tc
  mise exec ruby@4.0.5 -- bin/rubocop
  mise exec ruby@4.0.5 -- bin/rubycritic
  mise exec ruby@4.0.5 -- bin/rubycritic-changed "$empty_tree"
  mise exec ruby@4.0.5 -- bin/bundler-audit
  mise exec ruby@4.0.5 -- bin/importmap audit
  mise exec ruby@4.0.5 -- bin/brakeman --no-pager
fi
